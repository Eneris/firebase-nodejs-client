{
    "compilerOptions": {
        "rootDir": "src",
        "declaration": true,
        "declarationMap": true,
        "outDir": "dist",
        "module": "CommonJS",
        "target": "ESNext",
        "types": ["node"],
        "sourceMap": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "exclude": [
        "dist"
    ]
}