{
  "name": "@eneris/firebase-nodejs-client",
  "version": "1.0.0-push-receiver",
  "description": "Firebase NodeJS client",
  "author": "Eneris<eneris.cz@gmail.com>",
  "homepage": "https://github.com/Eneris/firebase-nodejs-client",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "wiki",
    "package*",
    "*.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/eneris/firebase-nodejs-client.git"
  },
  "bugs": {
    "url": "https://github.com/Eneris/firebase-nodejs-client/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "experimental"
  },
  "keywords": [
    "node",
    "firebase",
    "remote-config",
    "analytics",
    "cloud-messaging",
    "fcm",
    "gcm",
    "push-notifications",
    "push-receiver"
  ],
  "scripts": {
    "prepack": "yarn build",
    "protobuf": "pbjs -t static-module -w commonjs -o src/protobuf/protos.js src/protobuf/*.proto && pbts -o src/protobuf/protos.d.ts src/protobuf/protos.js",
    "build": "yarn clean && yarn protobuf && yarn tsc --incremental && mkdir -p dist/protobuf && cp src/protobuf/protos.js src/protobuf/protos.d.ts dist/protobuf/",
    "lint": "yarn eslint src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "precommit": "yarn lint && yarn build"
  },
  "dependencies": {
    "dot-prop": "^10.1.0",
    "eventemitter3": "^5.0.4",
    "fetch-retry": "^6.0.0",
    "http_ece": "^1.2.1",
    "jsonwebtoken": "^9.0.3",
    "long": "^5.3.2",
    "protobufjs": "^8.0.0"
  },
  "devDependencies": {
    "@eneris/conf": "^15.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "protobufjs-cli": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
